<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.achievement.mapper.DemandSourceMapper">

    <select id="selectActiveSources" resultType="com.achievement.domain.po.DemandSource">
        SELECT *
        FROM demand_sources
        WHERE is_delete = 0
        ORDER BY enabled DESC, priority DESC, updated_at DESC, id DESC
    </select>
</mapper>
